# Discord bot token and application ID (Developer Portal > your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands only in this server (use for the dev bot)
DEV_GUILD_ID=
# Comma-separated Discord user IDs allowed to run owner-only commands
OWNER_IDS=

# SQLite database file
DATABASE_PATH=data/leurs.db

# Integrations (leave empty to disable the matching commands)
LASTFM_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

LOG_LEVEL=info
